{
  "name": "@ronas-it/axios-api-client",
  "version": "0.3.0",
  "description": "Wrapper utilities for interaction with REST APIs using Axios",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup-node",
    "release": "npm publish",
    "lint": "npx tsc && npx eslint ./",
    "format": "npx prettier --write . && npm run lint -- --fix",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RonasIT/axios-api-client.git"
  },
  "keywords": [
    "query",
    "api",
    "typescript",
    "crud"
  ],
  "author": "Ronas IT",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RonasIT/axios-api-client/issues"
  },
  "homepage": "https://github.com/RonasIT/axios-api-client#readme",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/base-64": "^1.0.2",
    "@types/node": "^22.20.5",
    "axios": "^1.21.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "peerDependencies": {
    "axios": "^1.20.0"
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --cache --fix",
    "*.{js,ts,css,md}": "prettier --write"
  },
  "dependencies": {
    "base-64": "^1.0.0",
    "jwt-decode": "^4.0.0"
  }
}
